set(TEST_NAME channel-${SUITE}-np${RANKS})
set(DRIVER_TIMEOUT 240)
include("${CMAKE_CURRENT_LIST_DIR}/driver_helpers.cmake")

function(channel_run prefix)
  cmake_parse_arguments(RUN "" "RANKS;EXPECTED;CODE" "" ${ARGN})
  if(NOT RUN_RANKS)
    set(RUN_RANKS ${RANKS})
  endif()
  set(arguments ${RUN_UNPARSED_ARGUMENTS})
  if(NOT "--mesh" IN_LIST arguments)
    list(APPEND arguments --mesh "${MESH}")
  endif()
  if(NOT "--refinements" IN_LIST arguments)
    list(APPEND arguments --refinements 0)
  endif()
  if(NOT "--visualization" IN_LIST arguments AND NOT "--no-visualization" IN_LIST arguments)
    list(APPEND arguments --no-visualization)
  endif()
  run_driver(output ${RUN_RANKS} "${RUN_EXPECTED}" "${RUN_CODE}" ${arguments})
  if(NOT "${RUN_EXPECTED}" STREQUAL "")
    return()
  endif()
  read_records("${output}" "channel_" records)
  list(FILTER records EXCLUDE REGEX "^channel_step")
  string(REPLACE ";" "\n" records "${records}")
  load_fields("${records}" report)
  if(NOT "${report_converged}" STREQUAL "1" OR NOT "${report_pressure_nullspace}" STREQUAL "0" OR
     NOT "${report_completed_steps}" STREQUAL "${report_requested_steps}" OR
     NOT report_mass_imbalance LESS 2e-8 OR NOT report_mask_volume GREATER 0)
    message(FATAL_ERROR "Invalid channel convergence, continuation, flux, or inclusion mask: ${output}")
  endif()
  check_close("${report_inlet_flux}" "-${report_inlet_speed}" "Prescribed discrete inlet flux")
  check_close("${report_outlet_flux}" "${report_inlet_speed}" "Outlet flux")
  check_close("${report_wall_flux}" 0 "Wall flux")
  check_close("${report_net_flux}" "${report_volume_flux}" "Boundary/divergence flux agreement")
  foreach(key IN LISTS report_keys)
    set(${prefix}_${key} "${report_${key}}" PARENT_SCOPE)
  endforeach()
endfunction()

function(compare_channels first second)
  foreach(field velocity_l2 pressure_drop inclusion_rms force_x force_y force_z
      penalty_power mask_volume inlet_flux outlet_flux)
    check_close("${${first}_${field}}" "${${second}_${field}}" "${first}/${second}: ${field}")
  endforeach()
endfunction()

if(SUITE STREQUAL "smoke")
  foreach(convection OFF ON)
    set(physics)
    if(convection)
      set(physics --convection)
    endif()
    channel_run(baseline ${physics} --penalty 0)
    channel_run(penalized ${physics})
    if(NOT penalized_inclusion_rms LESS baseline_inclusion_rms OR
       NOT penalized_pressure_drop GREATER baseline_pressure_drop OR
       NOT penalized_force_x GREATER 0 OR NOT penalized_penalty_power GREATER 0)
      message(FATAL_ERROR "Incorrect penalty effect, Brinkman force, or dissipation")
    endif()
    check_close("${baseline_force_x}" 0 "Zero-penalty force")
    check_close("${baseline_penalty_power}" 0 "Zero-penalty dissipation")
    if(USE_MUMPS)
      channel_run(reference ${physics} --backend mumps)
      compare_channels(penalized reference)
    endif()
  endforeach()
elseif(SUITE STREQUAL "parallel")
  foreach(convection OFF ON)
    set(physics)
    if(convection)
      set(physics --convection)
    endif()
    channel_run(serial RANKS 1 ${physics})
    channel_run(parallel ${physics})
    compare_channels(serial parallel)
  endforeach()
elseif(SUITE STREQUAL "features")
  channel_run(baseline --convection)
  channel_run(continuation --convection --load-steps 3)
  compare_channels(baseline continuation)
  channel_run(picard --convection --nonlinear-method picard)
  compare_channels(baseline picard)
  set(pressure_solvers amg)
  if(USE_MUMPS)
    list(APPEND pressure_solvers mumps)
  endif()
  foreach(solver IN LISTS pressure_solvers)
    foreach(schur lsc pcd)
      channel_run(alternative --convection --schur ${schur} --${schur}-solver ${solver} --${schur}-amg-cycles 2)
      compare_channels(baseline alternative)
    endforeach()
  endforeach()
  channel_run(shifted --convection --outlet-pressure 2)
  compare_channels(baseline shifted)
  check_close("${shifted_inlet_pressure}" "${baseline_inlet_pressure}" "Inlet pressure shift" 2e-7 2e-9 2)
  check_close("${shifted_outlet_pressure}" "${baseline_outlet_pressure}" "Outlet pressure shift" 2e-7 2e-9 2)
  set(visualization "${test_directory}/paraview")
  set(summary "${test_directory}/summary.txt")
  channel_run(visualized --visualization --output "${visualization}" --summary "${summary}")
  file(READ "${summary}" contents)
  if(NOT contents MATCHES "channel_diagnostics")
    message(FATAL_ERROR "Missing saved report")
  endif()
  check_values(visualization "${visualization}" ${RANKS})
elseif(SUITE STREQUAL "resolution")
  channel_run(coarse)
  channel_run(refined --refinements 1)
  math(EXPR expected_elements "8*${coarse_elements}")
  if(NOT refined_elements EQUAL expected_elements OR NOT refined_h_max LESS coarse_h_max)
    message(FATAL_ERROR "Uniform refinement did not split every cell or reduce mesh size")
  endif()
  channel_run(serial --serial-refinements 1)
  if(NOT serial_serial_elements EQUAL refined_elements OR NOT serial_serial_refinements EQUAL 1)
    message(FATAL_ERROR "Explicit refinement did not happen before partitioning")
  endif()
  math(EXPR threshold "${coarse_elements}/${RANKS}")
  channel_run(automatic --min-elements-per-rank ${threshold})
  if(NOT automatic_partition_min GREATER threshold OR automatic_serial_refinements LESS 1)
    message(FATAL_ERROR "Serial refinement did not enforce the strict per-rank threshold")
  endif()
  get_filename_component(mesh_name "${MESH}" NAME)
  if(DEFINED REFINER AND mesh_name MATCHES "hex")
    set(refined_mesh "${test_directory}/serial-refined.mesh")
    set(command "${REFINER}" --mesh "${MESH}" --output "${refined_mesh}" --factor-x 2 --factor-y 1 --factor-z 1)
    execute_process(COMMAND ${command} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 60)
    if(NOT "${result}" STREQUAL "0")
      message(FATAL_ERROR "Serial refiner failed: ${result}\n${output}${errors}")
    endif()
    channel_run(anisotropic --mesh "${refined_mesh}")
    math(EXPR expected_elements "2*${coarse_elements}")
    if(NOT anisotropic_elements EQUAL expected_elements)
      message(FATAL_ERROR "Anisotropic serial subdivision has the wrong element count")
    endif()
    check_close("${anisotropic_h_max}" 0.5 "Maximum anisotropic element size")
    execute_process(COMMAND ${command} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 60)
    if(NOT "${result}" STREQUAL "2" OR NOT errors MATCHES "overwrite")
      message(FATAL_ERROR "Serial refiner overwrote its output: ${result}\n${output}${errors}")
    endif()
  endif()
  channel_run(quadrature --quadrature 12)
  channel_run(order --order 3)
  channel_run(inclusion --radius 0.15 --interface-width 0.025 --center-x 4.8)
  channel_run(penalty --penalty 1000)
  channel_run(stokes --inlet-speed 0.001)
  channel_run(navier --inlet-speed 0.001 --convection)
  check_close("${stokes_velocity_l2}" "${navier_velocity_l2}" "Low-Re Stokes limit" 1e-4)
elseif(SUITE STREQUAL "invalid")
  channel_run(invalid EXPECTED "Cannot read channel mesh" CODE 2 --mesh "${test_directory}/missing.mesh")
  foreach(specification
      "--refinements|-1|Require refinements"
      "--serial-refinements|-1|Serial refinements"
      "--min-elements-per-rank|-1|Serial refinements"
      "--order|1|Require refinements"
      "--quadrature|0|Require refinements"
      "--viscosity|0|Invalid channel viscosity"
      "--penalty|-1|Invalid channel viscosity"
      "--inlet-speed|nan|Wrong option format"
      "--inlet-speed|1e999|Invalid channel viscosity"
      "--radius|0|Invalid inclusion"
      "--interface-width|0.3|Invalid inclusion"
      "--center-y|0.1|must lie strictly inside"
      "--backend|unknown|backend must be"
      "--schur|unknown|Schur approximation must be"
      "--lsc-solver|unknown|LSC solver must be"
      "--lsc-amg-cycles|0|LSC AMG cycles must be positive"
      "--pcd-solver|unknown|PCD solver must be"
      "--pcd-amg-cycles|0|PCD AMG cycles must be positive"
      "--nonlinear-method|unknown|method must be"
      "--load-steps|2|Load steps require convection")
    string(REPLACE "|" ";" fields "${specification}")
    list(GET fields 0 option)
    list(GET fields 1 value)
    list(GET fields 2 expected)
    channel_run(invalid EXPECTED "${expected}" CODE 2 ${option} ${value})
  endforeach()
  foreach(schur lsc pcd)
    string(TOUPPER "${schur}" label)
    channel_run(invalid EXPECTED "${label} requires the fgmres backend" CODE 2 --schur ${schur} --backend mumps)
  endforeach()
  channel_run(invalid EXPECTED "not sampled by assembly quadrature" CODE 2 --radius 1e-8 --interface-width 1e-9)
  file(READ "${MESH}" original_mesh)
  string(REPLACE "\n" ";" original_lines "${original_mesh}")
  foreach(specification "boundary|99|boundary tags 1-6" "boundary|2|boundary tags 1-6" "elements|2|domain attribute 1")
    string(REPLACE "|" ";" fields "${specification}")
    list(GET fields 0 section)
    list(GET fields 1 attribute)
    list(GET fields 2 expected)
    set(lines "${original_lines}")
    list(FIND lines "${section}" index)
    if(index EQUAL -1)
      message(FATAL_ERROR "Missing mesh section ${section}")
    endif()
    math(EXPR index "${index}+2")
    list(GET lines ${index} entry)
    string(REGEX REPLACE "^[0-9]+" "${attribute}" entry "${entry}")
    list(REMOVE_AT lines ${index})
    list(INSERT lines ${index} "${entry}")
    string(REPLACE ";" "\n" contents "${lines}")
    set(invalid_mesh "${test_directory}/invalid-${section}-${attribute}.mesh")
    file(WRITE "${invalid_mesh}" "${contents}")
    channel_run(invalid EXPECTED "${expected}" CODE 2 --mesh "${invalid_mesh}")
  endforeach()
  set(failed_output "${test_directory}/failed-output")
  channel_run(invalid EXPECTED "channel_solve converged=0" CODE 1
    --linear-iterations 1 --visualization --output "${failed_output}")
  channel_run(invalid EXPECTED "channel_solve converged=0" CODE 1
    --convection --nonlinear-iterations 1 --inlet-speed 10 --visualization --output "${failed_output}")
  if(EXISTS "${failed_output}")
    message(FATAL_ERROR "Failed solve wrote success visualization")
  endif()
  channel_run(invalid EXPECTED "Cannot write channel summary" CODE 2 --summary "${test_directory}/missing/summary.txt")
else()
  message(FATAL_ERROR "Unknown channel suite: ${SUITE}")
endif()
finish_driver_test()
