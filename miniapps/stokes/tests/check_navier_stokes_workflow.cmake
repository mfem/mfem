set(TEST_NAME workflow-${SUITE}-${METHOD}-${SCENARIO}-${GEOMETRY}-np${RANKS})
set(DRIVER_TIMEOUT 120)
set(DRIVER_ERROR_LOG ON)
include("${CMAKE_CURRENT_LIST_DIR}/driver_helpers.cmake")
set(checkpoint "${test_directory}/state")
if(NOT DEFINED ORDER)
  set(ORDER 2)
endif()

function(check_checkpoint)
  fingerprints("${checkpoint}" current_files)
  if(NOT "${current_files}" STREQUAL "${original_files}")
    message(FATAL_ERROR "Execution changed checkpoint files: ${checkpoint}")
  endif()
endfunction()

if(SUITE STREQUAL "invalid")
  run_driver(output ${RANKS} "" "" --help)
  run_driver(output ${RANKS} "Unknown workflow discretization" "" --method unknown)
  run_driver(output ${RANKS} "requires explicit --experimental" "" --method pspg)
  run_driver(output ${RANKS} "Invalid workflow material" "" --viscosity -1)
  run_driver(output ${RANKS} "moving target requires positive" "" --target-speed 0.1)
  run_driver(output ${RANKS} "Traction amplitudes require" "" --tangential-traction 0.1)
  run_driver(output ${RANKS} "Unknown workflow backend" "" --backend gmg)
  run_driver(output ${RANKS} "Projected workflow gauge requires" ""
    --problem closed --gauge projected --backend mumps)
  run_driver(output ${RANKS} "Adjoint-only mode requires --checkpoint" "" --mode adjoint)
  set(forward --problem closed --drag 10 --checkpoint "${checkpoint}")
  set(adjoint --mode adjoint --checkpoint "${checkpoint}")
  run_driver(output ${RANKS} "" "" ${forward})
  fingerprints("${checkpoint}" original_files)
  run_driver(output ${RANKS} "physical options from the checkpoint" "" ${adjoint} --force 1)
  run_driver(output ${RANKS} "Checkpoint directory must be new" "" ${forward})
  check_checkpoint()
  run_driver(output ${RANKS} "Cannot read workflow checkpoint shard" ""
    --mode adjoint --checkpoint "${test_directory}/missing")
  math(EXPR shard_rank "${RANKS}-1")
  string(LENGTH "${shard_rank}" digits)
  while(digits LESS 6)
    set(shard_rank "0${shard_rank}")
    string(LENGTH "${shard_rank}" digits)
  endwhile()
  set(shard "${checkpoint}/pressure.${shard_rank}")
  file(READ "${shard}" saved_shard)
  file(REMOVE "${shard}")
  run_driver(output ${RANKS} "Cannot read workflow checkpoint shard" "" ${adjoint})
  file(WRITE "${shard}" "${saved_shard}corrupt")
  run_driver(output ${RANKS} "Workflow checkpoint shard checksum mismatch" "" ${adjoint})
  file(WRITE "${shard}" "${saved_shard}")
  file(READ "${checkpoint}/manifest" manifest)
  string(REPLACE "\n" ";" lines "${manifest}")
  math(EXPR wrong_ranks "${RANKS}+1")
  foreach(change
      "0|MFEM_NAVIER_STOKES_WORKFLOW 99|Unsupported workflow checkpoint manifest"
      "1|${wrong_ranks}|original MPI rank count"
      "4|0.8 10 0 50|Supplied Navier-Stokes state is not converged"
      "3|4 3 0 0|mesh/spaces do not match"
      "6|0 0|Invalid workflow checkpoint metadata"
      "7|100 100|objective values do not match")
    string(REPLACE "|" ";" fields "${change}")
    list(GET fields 0 index)
    list(GET fields 1 replacement)
    list(GET fields 2 expected)
    set(changed "${lines}")
    list(REMOVE_AT changed ${index})
    list(INSERT changed ${index} "${replacement}")
    string(REPLACE ";" "\n" changed "${changed}")
    file(WRITE "${checkpoint}/manifest" "${changed}")
    run_driver(output ${RANKS} "${expected}" "" ${adjoint})
    file(WRITE "${checkpoint}/manifest" "${manifest}")
  endforeach()
  run_driver(output ${RANKS} "" "" ${adjoint})
  check_checkpoint()
  set(failed "${test_directory}/failed-solve")
  run_driver(output ${RANKS} "forward converged=0" "" --linear-iterations 1 --checkpoint "${failed}")
  if(EXISTS "${failed}")
    message(FATAL_ERROR "A failed nonlinear solve produced a checkpoint")
  endif()
elseif(SUITE STREQUAL "round-trip")
  set(experimental)
  if(METHOD STREQUAL "pspg" OR METHOD STREQUAL "gls")
    set(experimental --experimental)
  endif()
  set(forward --checkpoint "${checkpoint}" --method ${METHOD} --order ${ORDER}
    --curved --${GEOMETRY} ${experimental})
  set(closed OFF)
  if(SCENARIO MATCHES "^closed-")
    set(closed ON)
    list(APPEND forward --problem closed --drag 20 --pressure 0.3)
    if(SCENARIO STREQUAL "closed-moving")
      list(APPEND forward --target-speed 0.05 --gauge projected)
    endif()
  elseif(SCENARIO STREQUAL "channel-traction")
    list(APPEND forward --outlet traction --normal-traction 0.03 --tangential-traction 0.015 --drag 15)
  elseif(NOT SCENARIO STREQUAL "channel-pressure")
    message(FATAL_ERROR "Unknown workflow scenario: ${SCENARIO}")
  endif()
  run_driver(forward_log ${RANKS} "" "" ${forward})
  load_record("${forward_log}" workflow 0 workflow)
  load_record("${forward_log}" forward 0 report)
  if(NOT "${workflow_forward_solves}" STREQUAL "1" OR
     NOT "${report_converged}" STREQUAL "1" OR NOT report_residual LESS 1e-9)
    message(FATAL_ERROR "Forward solve failed its true-residual check: ${forward_log}")
  endif()
  if(closed AND NOT report_gauge_error LESS 1e-9)
    message(FATAL_ERROR "Incorrect closed pressure mean")
  endif()
  load_record("${forward_log}" objectives 0 objectives)
  fingerprints("${checkpoint}" original_files)
  list(LENGTH original_files file_count)
  math(EXPR expected_count "1+3*${RANKS}")
  file(READ "${checkpoint}/manifest" manifest)
  if(NOT file_count EQUAL expected_count OR NOT manifest MATCHES "^MFEM_NAVIER_STOKES_WORKFLOW 1\n")
    message(FATAL_ERROR "Incomplete checkpoint or wrong schema")
  endif()
  set(backends mumps fgmres reaction)
  if(closed)
    list(APPEND backends projected)
  endif()
  set(reference_log)
  foreach(backend IN LISTS backends)
    set(solver --backend fgmres)
    if(backend STREQUAL "mumps")
      set(solver --backend mumps)
    elseif(backend STREQUAL "reaction")
      list(APPEND solver --schur reaction)
    elseif(backend STREQUAL "projected")
      list(APPEND solver --gauge projected)
    endif()
    run_driver(output ${RANKS} "" "" --mode adjoint --checkpoint "${checkpoint}" ${experimental} ${solver})
    load_record("${output}" workflow 0 workflow)
    file(READ "${output}" contents)
    if(NOT "${workflow_forward_solves}" STREQUAL "0" OR NOT contents MATCHES "state_unchanged=1")
      message(FATAL_ERROR "Reload ran a forward solve or changed supplied fields")
    endif()
    load_record("${output}" objectives 0 loaded)
    foreach(objective IN LISTS objectives_keys)
      check_close("${objectives_${objective}}" "${loaded_${objective}}" "Reloaded ${objective}" 1e-11 1e-12)
    endforeach()
    read_records("${output}" "adjoint " adjoints)
    list(LENGTH adjoints count)
    if(NOT count EQUAL 2)
      message(FATAL_ERROR "Both objective solves were not performed")
    endif()
    foreach(index RANGE 0 1)
      load_record("${output}" adjoint ${index} adjoint)
      if(NOT "${adjoint_converged}" STREQUAL "1" OR NOT "${adjoint_forward_valid}" STREQUAL "1" OR
         NOT "${adjoint_rhs_compatible}" STREQUAL "1" OR NOT "${adjoint_setup_reused}" STREQUAL "${index}" OR
         NOT adjoint_transpose_residual LESS 1e-9)
        message(FATAL_ERROR "Invalid supplied-state adjoint, setup reuse, or transpose residual")
      endif()
      if(reference_log)
        load_record("${reference_log}" adjoint ${index} reference)
        check_close("${adjoint_multiplier_norm}" "${reference_multiplier_norm}" "Adjoint backends" 5e-7 1e-9)
      endif()
    endforeach()
    if(NOT reference_log)
      set(reference_log "${output}")
    endif()
    check_checkpoint()
  endforeach()
  run_driver(output ${RANKS} "" "" --mode adjoint --checkpoint "${checkpoint}" --objective pressure ${experimental})
  read_records("${output}" "adjoint " adjoints)
  list(LENGTH adjoints count)
  if(NOT count EQUAL 1)
    message(FATAL_ERROR "Single-objective selection was ignored")
  endif()
  check_checkpoint()
else()
  message(FATAL_ERROR "Unknown workflow suite: ${SUITE}")
endif()
finish_driver_test()
