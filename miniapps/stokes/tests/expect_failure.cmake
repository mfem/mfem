set(ordering_message "Incompatible Navier-Stokes H1 spaces or ordering")
set(viscosity_message "Invalid Navier-Stokes viscosity")
set(direction_message "Invalid velocity BC direction")
set(attribute_message "Unknown Navier-Stokes boundary attribute")
set(dimension_message "Invalid Navier-Stokes component or coefficient dimension")
set(conflict_message "Conflicting or nonfinite velocity boundary values")
set(flux_message "Prescribed velocity has incompatible net boundary flux")
set(rigid_message "Velocity BCs leave an unconstrained rigid translation/rotation")
set(stabilization_message "Invalid Navier-Stokes stabilization scale")
set(preconditioner_message "Invalid Navier-Stokes iterative options")
set(smoothing_message "Invalid Navier-Stokes iterative options")
set(folded_geometry_message "Invalid Stokes geometry: nonpositive/nonfinite sampled signed Jacobian")
set(coordinate_family_message "Unsupported Navier-Stokes coordinate geometry")
set(pressure_order_message "Unsupported Navier-Stokes element orders or pair")
set(cip_gamma_message "Invalid Navier-Stokes stabilization scale")
set(gls_tau_message "Invalid Navier-Stokes stabilization scale")
set(cip_mesh_message "CIP requires refinement of fully Dirichlet tensor meshes")
if(DEFINED CLI_ARGUMENTS)
  set(arguments ${CLI_ARGUMENTS})
  set(expected_message "${EXPECTED_MESSAGE}")
else()
  set(arguments --invalid ${SCENARIO})
  if(DEFINED EXPECTED_MESSAGE)
    set(expected_message "${EXPECTED_MESSAGE}")
  else()
    set(expected_message "${${SCENARIO}_message}")
  endif()
endif()
if(NOT DEFINED RANKS)
  set(RANKS 4)
endif()
if(NOT DEFINED CLI_ARGUMENTS)
  string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef log_id)
  set(log_directory "${CMAKE_CURRENT_BINARY_DIR}/expected-stokes-errors")
  file(MAKE_DIRECTORY "${log_directory}")
  set(log_prefix "${log_directory}/${SCENARIO}-np${RANKS}-${log_id}")
  list(APPEND arguments --error-log "${log_prefix}")
endif()
execute_process(COMMAND ${LAUNCHER} ${NUMPROC_FLAG} ${RANKS} ${PREFLAGS}
  ${EXECUTABLE} ${arguments} ${POSTFLAGS}
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 45)
if(DEFINED log_prefix)
  math(EXPR last_rank "${RANKS}-1")
  foreach(rank RANGE 0 ${last_rank})
    set(log_file "${log_prefix}.${rank}")
    if(EXISTS "${log_file}")
      file(READ "${log_file}" diagnostics)
      string(APPEND errors "\n${diagnostics}")
      file(REMOVE "${log_file}")
    endif()
  endforeach()
endif()
string(FIND "${output}${errors}" "${expected_message}" location)
if(NOT "${result}" MATCHES "^[0-9]+$" OR "${result}" STREQUAL "0" OR location EQUAL -1)
  message(FATAL_ERROR "Missing expected ${SCENARIO} failure: ${result}\n${output}\n${errors}")
endif()
