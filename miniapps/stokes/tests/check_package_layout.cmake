cmake_minimum_required(VERSION 3.12)
get_filename_component(package "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)

function(require_count content expression expected)
  string(REGEX MATCHALL "${expression}" matches "${content}")
  list(LENGTH matches count)
  if(NOT count EQUAL expected)
    message(FATAL_ERROR "Expected ${expected} occurrences of ${expression}, found ${count}")
  endif()
endfunction()

function(require_text content text)
  string(FIND "${content}" "${text}" location)
  if(location EQUAL -1)
    message(FATAL_ERROR "Missing canonical declaration: ${text}")
  endif()
endfunction()

foreach(directory examples tests docs)
  if(NOT IS_DIRECTORY "${package}/${directory}")
    message(FATAL_ERROR "Missing package directory: ${directory}")
  endif()
endforeach()
foreach(directory core discretization preconditioners)
  if(EXISTS "${package}/${directory}")
    message(FATAL_ERROR "Obsolete implementation directory: ${directory}")
  endif()
endforeach()
file(GLOB headers RELATIVE "${package}" "${package}/*.hpp")
file(GLOB sources RELATIVE "${package}" "${package}/*.cpp")
if(NOT "${headers}" STREQUAL "stokes.hpp" OR NOT "${sources}" STREQUAL "stokes.cpp")
  message(FATAL_ERROR "The numerical library must remain one header/source pair")
endif()
file(GLOB_RECURSE scripts LIST_DIRECTORIES TRUE "${package}/*")
list(FILTER scripts INCLUDE REGEX "\\.(py|pyc|pyo)$|/__pycache__$")
if(scripts)
  message(FATAL_ERROR "The flow package must not contain Python files or caches: ${scripts}")
endif()
file(READ "${package}/CMakeLists.txt" build)
if(build MATCHES "find_package\\(Python|Python[0-9]?_EXECUTABLE")
  message(FATAL_ERROR "The flow package must not require a Python interpreter")
endif()
if(NOT build MATCHES "add_library\\(stokes_core[ \n]+STATIC[ \n]+stokes\\.cpp\\)")
  message(FATAL_ERROR "stokes_core must compile only stokes.cpp")
endif()
file(READ "${package}/stokes.hpp" header)
file(READ "${package}/stokes.cpp" source)
require_count("${source}" "class FlowSolver::Impl\n" 1)
require_count("${source}" "class FlowAdjointSolver::Impl\n" 1)
require_text("${source}" "class detail::FlowAssembly")
require_text("${source}" "FlowSolver::Solve")
if(source MATCHES "tests/linear_case\\.hpp")
  message(FATAL_ERROR "The solver must not depend on a test fixture")
endif()
foreach(declaration "class FlowProblem" "struct FlowSolverOptions" "struct FlowSolveReport"
    "class FlowSolver" "class FlowAdjointSolver")
  require_count("${header}" "${declaration}\n" 1)
endforeach()
foreach(declaration "enum class PreconditionerType" "using Stabilization = std::variant<" "Mode GetMode() const")
  require_text("${header}" "${declaration}")
endforeach()
require_text("${source}" "const Stabilization &stabilization;")
if(header MATCHES "using FlowProblem|struct FlowSolverOptions :|namespace stokes =|namespace navier_stokes =")
  message(FATAL_ERROR "The public API must not retain legacy aliases")
endif()
set(obsolete "StokesSolver|StokesSolverOptions|StokesSolveInfo|StokesAdjointSolver|StokesAdjointOptions|StokesAdjointSolveInfo|StokesForwardState|LinearFlowSolver|NonlinearFlowSolver|LinearBrinkmanSystem|SteadyNavierStokesProblem|SteadyNavierStokesOptions|StokesBrinkmanOptions|SteadyNavierStokesSolver|StokesBrinkmanSolver|SteadyNavierStokesAdjointSolver|StokesBrinkmanAdjointSolver|SolveReport|StokesPreconditionerType|StokesPreconditionerName|StokesStabilizationMethod|StokesStabilizationMethodName|StokesPressureGauge|StokesPressureGaugeName")
file(GLOB_RECURSE code "${package}/*.cpp" "${package}/*.hpp")
foreach(path IN LISTS code)
  file(READ "${path}" contents)
  if(contents MATCHES "(^|[^a-zA-Z_0-9])(${obsolete})([^a-zA-Z_0-9]|$)" OR
     contents MATCHES "namespace[ \n]+mfem::(stokes|navier_stokes)([^a-zA-Z_0-9]|$)")
    message(FATAL_ERROR "Obsolete flow API in ${path}")
  endif()
  string(REGEX MATCHALL "#include \"[^\"]+\"" includes "${contents}")
  foreach(include IN LISTS includes)
    string(REGEX REPLACE "#include \"([^\"]+)\"" "\\1" include "${include}")
    if(include MATCHES "^(core|discretization|preconditioners)/" OR
       (NOT include STREQUAL "mfem.hpp" AND NOT EXISTS "${package}/${include}"))
      message(FATAL_ERROR "Noncanonical or missing include ${include} in ${path}")
    endif()
  endforeach()
endforeach()
file(READ "${package}/tests/linear_case.hpp" fixture)
if(fixture MATCHES "real_t[ \n]+(pspg_constant|cip_gamma|gls_tau_scale)([^a-zA-Z_0-9]|$)")
  message(FATAL_ERROR "Legacy stabilization parameters in the test fixture")
endif()
file(GLOB documents "${package}/docs/*.md")
list(APPEND documents "${package}/README.md")
foreach(path IN LISTS documents)
  file(READ "${path}" contents)
  string(REGEX MATCHALL "\\[[^]\n]+\\]\\([^ )\n]+\\)" links "${contents}")
  get_filename_component(directory "${path}" DIRECTORY)
  foreach(link IN LISTS links)
    string(REGEX REPLACE "^.*\\]\\(([^)]+)\\)$" "\\1" link "${link}")
    if(NOT link MATCHES "://|^#")
      string(REGEX REPLACE "#.*$" "" link "${link}")
      if(NOT EXISTS "${directory}/${link}")
        message(FATAL_ERROR "Broken documentation link ${link} in ${path}")
      endif()
    endif()
  endforeach()
endforeach()
message(STATUS "C++/CMake package layout checks passed")
