cmake_minimum_required(VERSION 3.12)

foreach(required EXECUTABLE CHECKER LAUNCHER NUMPROC_FLAG RANKS)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef identifier)
set(test_directory "${CMAKE_CURRENT_BINARY_DIR}/stokes-driver-tests/${TEST_NAME}-${identifier}")
file(MAKE_DIRECTORY "${test_directory}")
set_property(GLOBAL PROPERTY driver_calls 0)

function(run_driver destination ranks expected expected_code)
  get_property(calls GLOBAL PROPERTY driver_calls)
  math(EXPR calls "${calls}+1")
  set_property(GLOBAL PROPERTY driver_calls ${calls})
  set(arguments ${ARGN})
  set(log_prefix "${test_directory}/diagnostic-${calls}")
  if(DRIVER_ERROR_LOG)
    list(APPEND arguments --error-log "${log_prefix}")
  endif()
  execute_process(COMMAND ${LAUNCHER} ${NUMPROC_FLAG} ${ranks} ${PREFLAGS}
    "${EXECUTABLE}" ${arguments} ${POSTFLAGS}
    WORKING_DIRECTORY "${test_directory}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT ${DRIVER_TIMEOUT})
  string(APPEND output "${errors}")
  if(DRIVER_ERROR_LOG)
    math(EXPR last_rank "${ranks}-1")
    foreach(rank RANGE 0 ${last_rank})
      if(EXISTS "${log_prefix}.${rank}")
        file(READ "${log_prefix}.${rank}" diagnostic)
        string(APPEND output "${diagnostic}")
      endif()
    endforeach()
  endif()
  set(log_file "${test_directory}/run-${calls}.log")
  file(WRITE "${log_file}" "${output}")
  message(STATUS "RUN ${arguments}: exit=${result}, log=${log_file}")
  if(NOT "${result}" MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Driver failed to finish: ${result}\n${output}")
  endif()
  if("${expected}" STREQUAL "")
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Driver failed: ${result}\n${output}")
    endif()
  else()
    string(FIND "${output}" "${expected}" location)
    if(result EQUAL 0 OR location EQUAL -1)
      message(FATAL_ERROR "Missing expected diagnostic '${expected}': ${result}\n${output}")
    endif()
    if(NOT "${expected_code}" STREQUAL "" AND NOT "${result}" STREQUAL "${expected_code}")
      message(FATAL_ERROR "Expected exit ${expected_code}, got ${result}\n${output}")
    endif()
  endif()
  set(${destination} "${log_file}" PARENT_SCOPE)
endfunction()

function(check_values)
  execute_process(COMMAND "${CHECKER}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Driver check ${ARGN} failed: ${output}${errors}\nLogs: ${test_directory}")
  endif()
endfunction()

function(check_close actual expected description)
  set(relative 2e-7)
  set(absolute 2e-9)
  set(offset 0)
  if(ARGC GREATER 3)
    set(relative "${ARGV3}")
  endif()
  if(ARGC GREATER 4)
    set(absolute "${ARGV4}")
  endif()
  if(ARGC GREATER 5)
    set(offset "${ARGV5}")
  endif()
  message(STATUS "Checking ${description}")
  set(comparison close)
  if(NOT "${offset}" STREQUAL "0")
    set(comparison difference)
  endif()
  check_values(${comparison} "${actual}" "${expected}" "${relative}" "${absolute}" "${offset}")
endfunction()

function(read_records log_file prefix destination)
  file(STRINGS "${log_file}" lines REGEX "^${prefix}")
  set(${destination} "${lines}" PARENT_SCOPE)
endfunction()

function(load_fields record prefix)
  string(REGEX MATCHALL "[a-z][a-z_0-9]*=[^ \r\n]+" fields "${record}")
  set(keys)
  set(numbers)
  foreach(field IN LISTS fields)
    string(REGEX REPLACE "=.*$" "" key "${field}")
    string(REGEX REPLACE "^[^=]*=" "" value "${field}")
    set(${prefix}_${key} "${value}" PARENT_SCOPE)
    list(APPEND keys "${key}")
    if(value MATCHES "^[+-]?([0-9]+\\.?[0-9]*|\\.[0-9]+)([eE][+-]?[0-9]+)?$" OR
       value MATCHES "^[+-]?(nan|inf)")
      list(APPEND numbers "${value}")
    endif()
  endforeach()
  if(numbers)
    check_values(finite ${numbers})
  endif()
  list(REMOVE_DUPLICATES keys)
  set(${prefix}_keys "${keys}" PARENT_SCOPE)
endfunction()

function(load_record log_file kind index prefix)
  read_records("${log_file}" "${kind} " records)
  list(LENGTH records count)
  if(NOT count GREATER index)
    message(FATAL_ERROR "Missing ${kind} record ${index} in ${log_file}")
  endif()
  list(GET records ${index} record)
  load_fields("${record}" fields)
  foreach(key IN LISTS fields_keys)
    set(${prefix}_${key} "${fields_${key}}" PARENT_SCOPE)
  endforeach()
  set(${prefix}_keys "${fields_keys}" PARENT_SCOPE)
endfunction()

function(fingerprints directory destination)
  file(GLOB entries LIST_DIRECTORIES FALSE RELATIVE "${directory}" "${directory}/*")
  list(SORT entries)
  set(hashes)
  foreach(entry IN LISTS entries)
    file(SHA256 "${directory}/${entry}" digest)
    list(APPEND hashes "${entry}:${digest}")
  endforeach()
  set(${destination} "${hashes}" PARENT_SCOPE)
endfunction()

function(finish_driver_test)
  get_property(calls GLOBAL PROPERTY driver_calls)
  message(STATUS "${TEST_NAME} passed: ${calls} MPI launches, ${RANKS} ranks")
  file(REMOVE_RECURSE "${test_directory}")
endfunction()
