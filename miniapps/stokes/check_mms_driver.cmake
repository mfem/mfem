if(NOT DEFINED SOLVER)
  set(SOLVER fgmres)
endif()
if(NOT DEFINED PRECONDITIONER)
  set(PRECONDITIONER block-lower-p1-amg)
endif()
if(NOT DEFINED METHOD)
  set(METHOD taylor-hood)
endif()
if(DEFINED MMS_CASE)
  set(case_arguments --mms-case ${MMS_CASE})
else()
  set(MMS_CASE no-slip)
endif()
if(NOT DEFINED RELATIVE_TOLERANCE)
  set(RELATIVE_TOLERANCE 1e-10)
endif()
if(DEFINED PRESSURE_GAUGE)
  set(pressure_gauge_arguments --pressure-gauge ${PRESSURE_GAUGE})
else()
  set(PRESSURE_GAUGE auto)
endif()
if(NOT DEFINED EXPECT_CONVERGED)
  set(EXPECT_CONVERGED 1)
endif()
if(EXPECT_CONVERGED)
  set(expected_exit 0)
  set(max_iterations 2000)
else()
  set(expected_exit 2)
  set(max_iterations 1)
endif()
if(NOT DEFINED SERIAL_REFINEMENTS)
  set(SERIAL_REFINEMENTS 0)
endif()
if(NOT DEFINED PARALLEL_REFINEMENTS)
  set(PARALLEL_REFINEMENTS 1)
endif()
set(first_level 0)
set(last_level ${PARALLEL_REFINEMENTS})
set(mesh_arguments --mesh "${MESH}")
if(NOT DEFAULT_REFINEMENTS)
  if(LONG_REFINEMENT_OPTIONS)
    list(APPEND mesh_arguments --refine-serial ${SERIAL_REFINEMENTS} --refine-parallel ${PARALLEL_REFINEMENTS})
  else()
    list(APPEND mesh_arguments -rs ${SERIAL_REFINEMENTS} -rp ${PARALLEL_REFINEMENTS})
  endif()
endif()
math(EXPR refinement_factor "1 << ${DIMENSION}")
if(MESH MATCHES "\\.mesh$")
  file(STRINGS "${MESH}" mesh_header LIMIT_COUNT 32)
  if(NOT mesh_header MATCHES "(^|;)elements;([0-9]+)(;|$)")
    message(FATAL_ERROR "Missing input element count in ${MESH}")
  endif()
  set(expected_elements ${CMAKE_MATCH_2})
  if(SERIAL_REFINEMENTS GREATER 0)
    foreach(refinement RANGE 1 ${SERIAL_REFINEMENTS})
      math(EXPR expected_elements "${expected_elements} * ${refinement_factor}")
    endforeach()
  endif()
endif()
if(DEFINED VISUALIZATION)
  string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
  set(visualization_directory "${CSV}-paraview-${suffix}")
  if(VISUALIZATION)
    set(visualization_arguments --paraview --output "${visualization_directory}")
  else()
    set(visualization_arguments --no-paraview --output "${visualization_directory}")
  endif()
endif()
execute_process(COMMAND ${LAUNCHER} ${NUMPROC_FLAG} ${RANKS} ${PREFLAGS}
  ${EXECUTABLE} ${mesh_arguments}
  --method ${METHOD} --solver ${SOLVER} --preconditioner ${PRECONDITIONER}
  --relative-tolerance ${RELATIVE_TOLERANCE} --max-iterations ${max_iterations} --variable-viscosity --csv "${CSV}"
  ${case_arguments} ${pressure_gauge_arguments} ${visualization_arguments} ${POSTFLAGS}
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 850)
if(NOT "${result}" STREQUAL "${expected_exit}")
  message(FATAL_ERROR "MMS driver failed: ${result}\n${output}\n${errors}")
endif()
string(REGEX MATCHALL "MMS_LEVEL [^\n]*" reports "${output}")
list(LENGTH reports count)
math(EXPR expected_reports "${last_level}-${first_level}+1")
if(NOT count EQUAL expected_reports)
  message(FATAL_ERROR "Expected ${expected_reports} level reports, got ${count}: ${output}")
endif()
if(SOLVER STREQUAL "mumps")
  set(iterations_pattern "0")
else()
  set(iterations_pattern "[1-9][0-9]*")
endif()
set(seconds_pattern "[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?")
set(phase_fields preconditioner_setup_seconds direct_setup_seconds linear_solve_seconds finalization_seconds)
set(timing_fields ${phase_fields} boundary_projection_seconds)
function(check_phase_times context)
  foreach(field ${timing_fields})
    if(NOT "${${field}}" MATCHES "^${seconds_pattern}$")
      message(FATAL_ERROR "Missing/nonfinite/negative ${field}: ${context}")
    endif()
  endforeach()
  foreach(field ${phase_fields})
    if(${field} GREATER solve_seconds)
      message(FATAL_ERROR "${field} exceeds inclusive solve time: ${context}")
    endif()
  endforeach()
  if(SOLVER STREQUAL "mumps")
    if(NOT preconditioner_setup_seconds EQUAL 0 OR NOT direct_setup_seconds GREATER 0)
      message(FATAL_ERROR "Incorrect direct setup timing: ${context}")
    endif()
  elseif(NOT direct_setup_seconds EQUAL 0 OR NOT preconditioner_setup_seconds GREATER 0)
    message(FATAL_ERROR "Incorrect Krylov setup timing: ${context}")
  endif()
  if((MMS_CASE STREQUAL "no-slip" AND NOT boundary_projection_seconds EQUAL 0) OR
     (MMS_CASE STREQUAL "smooth" AND NOT boundary_projection_seconds GREATER 0))
    message(FATAL_ERROR "Incorrect MMS projection timing: ${context}")
  endif()
endfunction()
foreach(level RANGE ${first_level} ${last_level})
  math(EXPR index "${level}-${first_level}")
  list(GET reports ${index} report)
  if(NOT report MATCHES "^MMS_LEVEL dim=${DIMENSION} level=${level} ")
    message(FATAL_ERROR "Incorrect mesh dimension or level detection: ${report}")
  endif()
  if(NOT report MATCHES " mms_case=${MMS_CASE} ")
    message(FATAL_ERROR "Incorrect manufactured-solution case: ${report}")
  endif()
  if(NOT report MATCHES "level=${level} .*outer_iterations=${iterations_pattern} converged=${EXPECT_CONVERGED} ")
    message(FATAL_ERROR "Invalid outer iteration/convergence report: ${report}")
  endif()
  if(NOT report MATCHES "method=${METHOD} solver=${SOLVER} preconditioner=${PRECONDITIONER} ")
    message(FATAL_ERROR "Invalid solver/preconditioner report: ${report}")
  endif()
  if(NOT report MATCHES "pressure_gauge=${PRESSURE_GAUGE} pressure_nullspace_detected=([01]) pressure_gauge_active=([01]) ")
    message(FATAL_ERROR "Missing/incorrect pressure-gauge diagnostics: ${report}")
  endif()
  if(NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
    message(FATAL_ERROR "Pressure nullspace and gauge treatment disagree: ${report}")
  endif()
  if(DEFINED PERIODIC AND NOT report MATCHES "periodic=${PERIODIC} ")
    message(FATAL_ERROR "Incorrect periodic mesh detection: ${report}")
  endif()
  if(DEFINED INTERFACES AND NOT report MATCHES "internal_interface_bcs=${INTERFACES} ")
    message(FATAL_ERROR "Incorrect internal interface detection: ${report}")
  endif()
  if(DEFINED GEOMETRY_ORDER AND NOT report MATCHES "geometry_order=${GEOMETRY_ORDER} integration_order=[1-9][0-9]* ")
    message(FATAL_ERROR "Incorrect geometry/quadrature diagnostics after refinement: ${report}")
  endif()
  if(DEFINED expected_elements)
    if(NOT report MATCHES " elements=${expected_elements} ")
      message(FATAL_ERROR "Expected ${expected_elements} elements after serial/parallel refinement: ${report}")
    endif()
    math(EXPR expected_elements "${expected_elements} * ${refinement_factor}")
  endif()
  string(TOLOWER "${report}" lowercase_report)
  if(lowercase_report MATCHES "=[-+]?(nan|inf)")
    message(FATAL_ERROR "Nonfinite MMS diagnostics: ${report}")
  endif()
  if(NOT report MATCHES " assembly_seconds=(${seconds_pattern})( |$)")
    message(FATAL_ERROR "Missing/nonfinite/negative assembly time: ${report}")
  endif()
  set(assembly_seconds ${CMAKE_MATCH_1})
  if(NOT report MATCHES " solve_seconds=(${seconds_pattern})( |$)")
    message(FATAL_ERROR "Missing/nonfinite/negative solve time: ${report}")
  endif()
  if(assembly_seconds GREATER CMAKE_MATCH_1)
    message(FATAL_ERROR "Assembly time exceeds the total solve time: ${report}")
  endif()
  set(solve_seconds ${CMAKE_MATCH_1})
  if(NOT report MATCHES " assembly_performed=1( |$)")
    message(FATAL_ERROR "Fresh MMS solve did not report assembly: ${report}")
  endif()
  foreach(field ${timing_fields})
    if(NOT report MATCHES " ${field}=(${seconds_pattern})( |$)")
      message(FATAL_ERROR "Missing phase timing ${field}: ${report}")
    endif()
    set(${field} ${CMAKE_MATCH_1})
  endforeach()
  check_phase_times("${report}")
  if(NOT report MATCHES " absolute_residual=(${seconds_pattern})( |$)")
    message(FATAL_ERROR "Missing/nonfinite/negative absolute residual: ${report}")
  endif()
endforeach()
file(STRINGS "${CSV}" rows)
list(LENGTH rows count)
math(EXPR expected_rows "${expected_reports}+1")
if(NOT count EQUAL expected_rows)
  message(FATAL_ERROR "CSV must contain a header and ${expected_reports} level rows")
endif()
list(GET rows 0 header)
if(NOT header MATCHES "outer_iterations,converged")
  message(FATAL_ERROR "CSV is missing outer iteration diagnostics")
endif()
if(NOT header MATCHES "geometry_order,integration_order")
  message(FATAL_ERROR "CSV is missing geometry/quadrature diagnostics")
endif()
string(REPLACE "," ";" columns "${header}")
list(FIND columns dimension dimension_column)
list(FIND columns mms_case case_column)
list(FIND columns assembly_seconds assembly_column)
list(FIND columns solve_seconds solve_column)
list(FIND columns pressure_gauge gauge_policy_column)
list(FIND columns pressure_nullspace_detected nullspace_column)
list(FIND columns pressure_gauge_active gauge_active_column)
list(LENGTH columns column_count)
foreach(field ${timing_fields} assembly_performed absolute_residual order pressure_order)
  list(FIND columns ${field} ${field}_column)
  if(${field}_column LESS 0)
    message(FATAL_ERROR "CSV is missing ${field}")
  endif()
endforeach()
if(dimension_column LESS 0 OR case_column LESS 0)
  message(FATAL_ERROR "CSV is missing the detected mesh dimension or MMS case")
endif()
set(accuracy_fields velocity_l2 velocity_h1 pressure_l2 boundary_l2_error)
set(rate_fields velocity_l2_rate velocity_h1_rate pressure_l2_rate boundary_l2_rate)
set(minimum_velocity_l2_rate 2.5)
set(minimum_velocity_h1_rate 1.7)
set(minimum_pressure_l2_rate 1.5)
set(minimum_boundary_l2_rate 2.0)
if(VERIFY_SMOOTH)
  set(smooth_fields ${accuracy_fields} ${rate_fields} hole_velocity_l2 boundary_dof_error boundary_flux gauge_multiplier projection_flux_before projection_correction_l2)
  foreach(field ${smooth_fields})
    list(FIND columns ${field} ${field}_column)
    if(${field}_column LESS 0)
      message(FATAL_ERROR "CSV is missing ${field}")
    endif()
  endforeach()
endif()
if(assembly_column LESS 0 OR solve_column LESS 0)
  message(FATAL_ERROR "CSV is missing assembly/solve timing columns")
endif()
if(gauge_policy_column LESS 0 OR nullspace_column LESS 0 OR gauge_active_column LESS 0)
  message(FATAL_ERROR "CSV is missing pressure-gauge diagnostics")
endif()
foreach(index RANGE 1 ${expected_reports})
  list(GET rows ${index} row)
  string(REPLACE "," ";" values "${row}")
  list(LENGTH values value_count)
  if(NOT value_count EQUAL column_count)
    message(FATAL_ERROR "CSV row has an incorrect number of columns: ${row}")
  endif()
  list(GET values ${dimension_column} mesh_dimension)
  list(GET values ${case_column} mms_case)
  if(NOT mms_case STREQUAL MMS_CASE)
    message(FATAL_ERROR "Incorrect CSV MMS case: ${row}")
  endif()
  if(NOT mesh_dimension STREQUAL "${DIMENSION}")
    message(FATAL_ERROR "Incorrect CSV mesh dimension: ${row}")
  endif()
  list(GET values ${assembly_column} assembly_seconds)
  list(GET values ${solve_column} solve_seconds)
  list(GET values ${assembly_performed_column} assembly_performed)
  if(NOT assembly_performed STREQUAL "1")
    message(FATAL_ERROR "CSV fresh solve did not report assembly: ${row}")
  endif()
  foreach(field ${timing_fields})
    list(GET values ${${field}_column} ${field})
  endforeach()
  check_phase_times("${row}")
  list(GET values ${absolute_residual_column} absolute_residual)
  list(GET values ${order_column} order)
  list(GET values ${pressure_order_column} pressure_order)
  if(NOT absolute_residual MATCHES "^${seconds_pattern}$" OR NOT order EQUAL 2 OR
     (METHOD STREQUAL "taylor-hood" AND NOT pressure_order EQUAL 1) OR
     (NOT METHOD STREQUAL "taylor-hood" AND NOT pressure_order EQUAL 2))
    message(FATAL_ERROR "Invalid absolute residual or polynomial degrees: ${row}")
  endif()
  list(GET values ${gauge_policy_column} gauge_policy)
  list(GET values ${nullspace_column} nullspace)
  list(GET values ${gauge_active_column} gauge_active)
  if(NOT gauge_policy STREQUAL PRESSURE_GAUGE OR NOT nullspace MATCHES "^[01]$" OR
     NOT nullspace STREQUAL gauge_active)
    message(FATAL_ERROR "Incorrect CSV pressure-gauge diagnostics: ${row}")
  endif()
  if(NOT assembly_seconds MATCHES "^${seconds_pattern}$" OR
     NOT solve_seconds MATCHES "^${seconds_pattern}$" OR
     assembly_seconds GREATER solve_seconds)
    message(FATAL_ERROR "Invalid CSV assembly/solve timing: ${row}")
  endif()
  if(VERIFY_SMOOTH)
    foreach(field ${smooth_fields})
      list(GET values ${${field}_column} ${field})
      if(NOT "${${field}}" MATCHES "^-?${seconds_pattern}$")
        message(FATAL_ERROR "Nonfinite ${field}: ${row}")
      endif()
    endforeach()
    if(hole_velocity_l2 LESS 0.01 OR boundary_dof_error LESS 0 OR boundary_dof_error GREATER 1e-8 OR
       boundary_flux LESS -1e-8 OR boundary_flux GREATER 1e-8 OR
       gauge_multiplier LESS -1e-8 OR gauge_multiplier GREATER 1e-8)
      message(FATAL_ERROR "Nonzero boundary lifting, flux compatibility, or gauge check failed: ${row}")
    endif()
    if((DIMENSION EQUAL 2 AND (velocity_l2 GREATER 0.05 OR velocity_h1 GREATER 1.0 OR pressure_l2 GREATER 0.2)) OR
       (DIMENSION EQUAL 3 AND (velocity_l2 GREATER 0.3 OR velocity_h1 GREATER 6.0 OR pressure_l2 GREATER 1.5)) OR
       boundary_l2_error GREATER 0.01 OR projection_correction_l2 LESS 0 OR projection_correction_l2 GREATER 0.01)
      message(FATAL_ERROR "Smooth MMS accuracy bound failed: ${row}")
    endif()
    if(index EQUAL expected_reports AND expected_reports GREATER 1)
      if((DIMENSION EQUAL 2 AND (velocity_l2 GREATER 0.001 OR velocity_h1 GREATER 0.05 OR pressure_l2 GREATER 0.02)) OR
         (DIMENSION EQUAL 3 AND (velocity_l2 GREATER 0.025 OR velocity_h1 GREATER 1.2 OR pressure_l2 GREATER 0.3)))
        message(FATAL_ERROR "Refined smooth MMS accuracy bound failed: ${row}")
      endif()
    endif()
    foreach(field ${accuracy_fields})
      if(${field} LESS 0 OR (index GREATER 1 AND NOT ${field} LESS previous_${field}))
        message(FATAL_ERROR "Smooth MMS ${field} does not decrease under refinement: ${row}")
      endif()
      set(previous_${field} ${${field}})
    endforeach()
    foreach(field ${rate_fields})
      if(index EQUAL 1)
        if(NOT ${field} EQUAL 0)
          message(FATAL_ERROR "Initial smooth MMS ${field} must be zero: ${row}")
        endif()
      elseif(NOT ${field} GREATER minimum_${field})
        message(FATAL_ERROR "Smooth MMS ${field} must exceed ${minimum_${field}}: ${row}")
      endif()
    endforeach()
  endif()
endforeach()
if(DEFINED VISUALIZATION)
  if(VISUALIZATION)
    set(collection "${visualization_directory}/stokes_mms_${DIMENSION}d")
    file(READ "${collection}/stokes_mms_${DIMENSION}d.pvd" pvd)
    string(REGEX MATCHALL "<DataSet [^>]+>" datasets "${pvd}")
    list(LENGTH datasets count)
    if(NOT count EQUAL expected_reports)
      message(FATAL_ERROR "ParaView series must retain all ${expected_reports} levels")
    endif()
    foreach(level RANGE ${first_level} ${last_level})
      math(EXPR index "${level}-${first_level}")
      list(GET datasets ${index} dataset)
      if(NOT dataset MATCHES "timestep=\"${level}\"")
        message(FATAL_ERROR "Incorrect refinement-level timestep: ${dataset}")
      endif()
      string(REGEX MATCH "file=\"([^\"]+)\"" matched "${dataset}")
      set(pvtu_path "${collection}/${CMAKE_MATCH_1}")
      get_filename_component(cycle_directory "${pvtu_path}" DIRECTORY)
      file(READ "${pvtu_path}" pvtu)
      foreach(field velocity pressure)
        if(NOT pvtu MATCHES "Name=\"${field}\"")
          message(FATAL_ERROR "Missing ${field} field in ${pvtu_path}")
        endif()
      endforeach()
      string(REGEX MATCHALL "<Piece Source=\"[^\"]+\"[^>]*>" pieces "${pvtu}")
      list(LENGTH pieces count)
      if(NOT count EQUAL RANKS)
        message(FATAL_ERROR "Expected ${RANKS} parallel VTU pieces, got ${count}")
      endif()
      foreach(piece IN LISTS pieces)
        string(REGEX MATCH "Source=\"([^\"]+)\"" matched "${piece}")
        set(vtu_path "${cycle_directory}/${CMAKE_MATCH_1}")
        file(READ "${vtu_path}" vtu)
        foreach(field velocity pressure)
          if(NOT vtu MATCHES "Name=\"${field}\"")
            message(FATAL_ERROR "Missing ${field} values in ${vtu_path}")
          endif()
        endforeach()
        if(NOT vtu MATCHES "</VTKFile>")
          message(FATAL_ERROR "Incomplete ParaView piece: ${vtu_path}")
        endif()
      endforeach()
    endforeach()
  elseif(EXISTS "${visualization_directory}")
    message(FATAL_ERROR "Disabled visualization created output files")
  endif()
endif()
message(STATUS "${output}")
