# Run a contact regression and require both process success and solver output.
execute_process(COMMAND "${CMAKE_COMMAND}" -E env
  OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 ${CONTACT_COMMAND}
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
message("${output}${errors}")
if (NOT "${status}" STREQUAL "0")
  message(FATAL_ERROR "Contact solve failed: ${status}")
endif()
if (EXPECT_STATE STREQUAL "slip" OR EXPECT_STATE STREQUAL "stick")
  if (NOT output MATCHES "${EXPECT_STATE}=[1-9][0-9]*")
    message(FATAL_ERROR "The Coulomb regression did not exercise ${EXPECT_STATE}.")
  endif()
endif()
if (EXPECT_STATE STREQUAL "zero")
  if (NOT output MATCHES "stick=0" OR output MATCHES "stick=[1-9][0-9]*")
    message(FATAL_ERROR "Zero-friction contact must not report sticking.")
  endif()
endif()
if (NOT EXPECT_STATE STREQUAL "none")
  if (NOT output MATCHES "Coupled residual norm")
    message(FATAL_ERROR "The Coulomb solver did not report convergence.")
  endif()
elseif (NOT output MATCHES "Final Energy objective")
  message(FATAL_ERROR "The frictionless solver did not report a solution.")
endif()
